# URL de l'API Laravel MOT ERP
#   en ligne : https://motransport.online/api
#   en local (Laragon) : https://agare.test/api — le .htaccess du backend force le HTTPS, activer SSL dans Laragon
VITE_API_URL=https://motransport.online/api

# Accès aux données :
#   live : API réelle uniquement (défaut en production)
#   auto : API réelle, bascule sur des données de démonstration si le serveur ne répond pas (défaut en développement)
#   demo : données de démonstration uniquement (présentations, tests sans serveur)
# VITE_API_MODE=auto
